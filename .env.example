# Copy this file to .env.local for local dev — never commit .env.local
# Set ALL of these in Vercel Dashboard → Project → Settings → Environment Variables

# App URL — set to your Vercel production domain (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Supabase — find in Supabase Dashboard → Project → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — find in Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Legacy single-price fallback (can be same as STRIPE_PRICE_ID_SOLO_MONTHLY)
STRIPE_PRICE_ID=price_...
# Price IDs for each plan (Stripe Dashboard → Products)
STRIPE_PRICE_ID_AGENCY_MONTHLY=price_...
STRIPE_PRICE_ID_AGENCY_ANNUAL=price_...
# Client-side price IDs (used on the upgrade page)
NEXT_PUBLIC_STRIPE_PRICE_ID_SOLO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_AGENCY_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_AGENCY_ANNUAL=price_...
# Webhook secret: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Cron security — generate a random string: openssl rand -hex 32
# Must match what Vercel sends as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-random-secret-here

# AI providers
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
